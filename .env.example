NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only notification worker configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
EMAIL_WORKER_SECRET=
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_PROVIDER=mock
# Brevo remains fail-closed unless all three staging safety controls are set.
EMAIL_EXTERNAL_DELIVERY_ENABLED=false
# Comma-separated exact addresses. Empty means no external recipient is allowed.
EMAIL_RECIPIENT_ALLOWLIST=
# Required UTC/RFC3339 cutoff in Brevo mode. Older outbox rows are never claimed.
EMAIL_DELIVERY_NOT_BEFORE=
# Optional URL used only by the manual worker launcher. Keep it on localhost until staging is deployed.
NOTIFICATION_WORKER_URL=http://127.0.0.1:3000

# Required only when EMAIL_PROVIDER=brevo. Local tests must keep the mock provider.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Metalduro
BREVO_TIMEOUT_MS=10000
